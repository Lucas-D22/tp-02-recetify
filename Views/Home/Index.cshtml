@{
    ViewData["Title"] = "Bienvenido a Recetify";
}
<div>
<h2>Recetify - Generador de recetas </h2>
<div>
<form action='@Url.Action("respuesta")' method="post">
    <div>
        <label> Nombre: <input type="text" name="name" required/></label>
    </div>
    <div>
        <label> Fecha de Nacimiento: <input type="date" name="fechaDeNacimiento" required max="@DateTime.Now.ToString("yyyy-MM-dd")"/></label>
    </div>
    @if(ViewBag.DateError != null)
    {
        <div class="text-danger">@ViewBag.DateError</div>
    }
    <div>
        <label> Tipo de Comida: 
            <input type="radio" name="TipoComida" value="true" required/> Caliente
            <input type="radio" name="TipoComida" value="false" required/> Fría
        </label>
    </div>
    <div>
        <label> Presupuesto (en pesos): <input type="number" name="presupuestoPesos" min="1" required/></label>
    </div>
     <div>
        <label> Cantidad de Personas: </label>
        <input type="number" name="cocinaPara" min="1" max="20" required/>
    </div>

    <button type="submit">Generar Receta</button>
</form>